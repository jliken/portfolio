---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .intro {
        display: flex;
        align-items: center;
        gap: 2rem;
      }

      .intro img {
        max-width: 50%;
        height: auto;
        border-radius: 2px;
      }

      .intro-text {
        display: flex;
        flex-direction: column;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="intro">
        <img src="/profile-pic.jpg" alt="Profile image" />

        <div class="intro-text">
          <p>
            I'm Jack Liken, a Physics graduate from the University of Edinburgh. I have specialised in high-powered (student) rocketry, and hope to expand my knowledge of aero-mechanical engineering with the goal of entering the space industry. To this end, I am enrolled in the University of Strathclyde's MSc Advanced Mechanical Engineering with Aerospace course, where I hope to apply my physics knowledge and further my understanding of rocketry.
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
